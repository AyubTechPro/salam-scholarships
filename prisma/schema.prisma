// Dynamic CMS: Static Pages
model StaticPage {
  id        String  @id @default(cuid())
  slug      String  @unique // "privacy", "terms", "partners"
  title     String
  titleRu   String?
  titleTj   String?
  content   String  @db.Text // Rich text HTML
  contentRu String? @db.Text
  contentTj String? @db.Text
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug, isActive])
}

// UI Dictionary (Dynamic Button & Label Manager)
model UIDictionary {
  id          String  @id @default(cuid())
  key         String  @unique // e.g., "consultation.button", "hero.cta", "footer.subscribe"
  en          String // English text
  ru          String? // Russian text
  tj          String? // Tajik text
  category    String? // Optional: "buttons", "labels", "messages", etc.
  description String? // Help text for admins

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
  @@index([category])
}

// Navigation Menu (Dynamic Navbar & Footer Links)
model NavigationMenu {
  id         String           @id @default(cuid())
  label      String // Display text (EN)
  labelRu    String?
  labelTj    String?
  href       String // URL path (e.g., "/opportunities" or "https://...")
  icon       String? // Optional icon name (e.g., "GraduationCap")
  order      Int              @default(0)
  location   String           @default("navbar") // "navbar", "footer", "both"
  section    String? // For footer: "quickLinks", "support", "legal", etc.
  parentId   String? // For submenus/dropdowns
  parent     NavigationMenu?  @relation("NavigationChildren", fields: [parentId], references: [id])
  children   NavigationMenu[] @relation("NavigationChildren")
  isActive   Boolean          @default(true)
  isExternal Boolean          @default(false) // External links open in new tab

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([location, isActive, order])
  @@index([parentId])
  @@index([order])
}

// SEO Configuration
model SEOConfig {
  id            String  @id @default(cuid())
  pagePath      String  @unique // e.g., "/", "/opportunities", "/about"
  title         String
  titleRu       String?
  titleTj       String?
  description   String  @db.Text
  descriptionRu String? @db.Text
  descriptionTj String? @db.Text
  keywords      String? // Comma-separated
  ogImage       String? // Open Graph image URL

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pagePath])
}

// Email Campaigns
model EmailCampaign {
  id        String  @id @default(cuid())
  subject   String
  subjectRu String?
  subjectTj String?
  content   String  @db.Text // HTML email content
  contentRu String? @db.Text
  contentTj String? @db.Text

  recipientType String @default("ALL") // ALL, FILTERED, CUSTOM
  filters       Json? // { fieldOfInterest?: string[], targetCountries?: string[], etc. }
  recipientIds  Json? // Array of user IDs for CUSTOM type

  status      String    @default("DRAFT") // DRAFT, SCHEDULED, SENT, FAILED
  sentAt      DateTime?
  sentCount   Int       @default(0)
  failedCount Int       @default(0)

  createdBy String // User ID of admin who created
  user      User   @relation("EmailCampaigns", fields: [createdBy], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

// B2B Partner & Organizer Portal
model Partner {
  id            String  @id @default(cuid())
  name          String
  nameRu        String?
  nameTj        String?
  email         String  @unique
  website       String?
  logo          String? // Cloudinary URL
  description   String? @db.Text
  descriptionRu String? @db.Text
  descriptionTj String? @db.Text
  country       String? // ISO country code
  type          String  @default("UNIVERSITY") // UNIVERSITY, FOUNDATION, ORGANIZATION, GOVERNMENT
  isVerified    Boolean @default(false)
  isActive      Boolean @default(true)

  // Analytics & Leads
  totalViews    Int @default(0)
  totalLeads    Int @default(0)
  totalPrograms Int @default(0)

  // Relations
  programs  Program[]        @relation("PartnerPrograms")
  inquiries PartnerInquiry[]
  leads     PartnerLead[]
  users     User[]           @relation("UserPartner")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, isVerified])
  @@index([type])
}

// Partner Inquiry (Organizations wanting to post opportunities)
model PartnerInquiry {
  id               String   @id @default(cuid())
  organizationName String
  contactName      String
  email            String
  phone            String?
  country          String? // ISO country code
  website          String?
  message          String   @db.Text
  status           String   @default("PENDING") // PENDING, APPROVED, REJECTED, CONTACTED
  adminNotes       String?  @db.Text
  partnerId        String? // If approved and converted to Partner
  partner          Partner? @relation(fields: [partnerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([partnerId])
}

// Partner Leads (Students who showed interest in Partner's programs)
model PartnerLead {
  id         String  @id @default(cuid())
  partnerId  String
  programId  String
  userId     String? // If user is registered
  name       String
  email      String
  profession String?
  country    String? // Student's country
  message    String? @db.Text
  source     String  @default("PROGRAM_VIEW") // PROGRAM_VIEW, CONSULTATION, APPLICATION

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  user    User?   @relation("UserPartnerLeads", fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([partnerId, createdAt])
  @@index([programId])
}

// Newsletter Subscribers
model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String?
  locale         String    @default("en") // Preferred language
  isActive       Boolean   @default(true)
  subscribedAt   DateTime  @default(now())
  unsubscribedAt DateTime?

  @@index([email])
  @@index([isActive])
}

// FAQ System
model FAQ {
  id         String  @id @default(cuid())
  question   String
  questionRu String?
  questionTj String?
  answer     String  @db.Text
  answerRu   String? @db.Text
  answerTj   String? @db.Text
  category   String? // "GENERAL", "APPLICATION", "SCHOLARSHIP", "VISA", etc.
  order      Int     @default(0) // For sorting
  isActive   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, isActive])
  @@index([order])
}

// How It Works Steps (Dynamic Wizard Steps)
model HowItWorksStep {
  id            String  @id @default(cuid())
  stepNumber    Int     @unique // 1, 2, 3, etc.
  title         String
  titleRu       String?
  titleTj       String?
  description   String  @db.Text
  descriptionRu String? @db.Text
  descriptionTj String? @db.Text
  icon          String? // Lucide icon name (e.g., "GraduationCap", "Globe", "BookOpen")
  order         Int     @default(0) // For sorting
  isActive      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
  @@index([isActive])
  @@index([stepNumber])
}

// Student Achievements (Success Wall) - Strict Trilingual System
model Achievement {
  id             String @id @default(cuid())
  studentName    String // Usually same across all languages
  universityName String // Usually same across all languages

  // Country - Separate fields per language (REQUIRED)
  countryTJ String
  countryRU String
  countryEN String

  // Program Name - Separate fields per language (REQUIRED)
  programNameTJ String
  programNameRU String
  programNameEN String

  // Testimonial - Separate fields per language (REQUIRED)
  testimonialTJ String @db.Text
  testimonialRU String @db.Text
  testimonialEN String @db.Text

  studentImage String // Cloudinary URL (shared across all versions)
  academicYear String // e.g., "2024-2025"
  category     ProgramLevel // BACHELOR, MASTER, PHD
  order        Int          @default(0) // For custom ordering
  isActive     Boolean      @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, order])
  @@index([category])
  @@index([academicYear])
  @@index([order])
}
