# =========================
# SALAM GLOBAL OPPORTUNITY PLATFORM
# Environment Variables Configuration
# =========================
# 
# Copy this file to .env and fill in your actual values
# cp .env.example .env
#
# =========================
# CORE
# =========================
NODE_ENV=development
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET

# If you use these anywhere in client code:
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# =========================
# DATABASE (PostgreSQL)
# =========================
# Required: PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Example: postgresql://postgres:password@localhost:5432/sgop?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/sgop?schema=public"

# =========================
# AUTH PROVIDERS (Optional)
# =========================
# Google OAuth - Get credentials from https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple OAuth - Get credentials from https://developer.apple.com/
APPLE_ID=
APPLE_SECRET=

# =========================
# EMAIL (Choose one method)
# =========================
# Option 1: Resend (Recommended - easier setup)
# Get API key from https://resend.com/api-keys
RESEND_API_KEY=
FROM_EMAIL="Salam Global <noreply@yourdomain.com>"

# Option 2: SMTP (Traditional email server)
# Uncomment and configure if not using Resend
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# =========================
# CLOUDINARY (Image storage)
# =========================
# Required for image uploads
# Get credentials from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# =========================
# AI (Optional - for AI-powered search and matching)
# =========================
# Enable AI features (true/false)
AI_ENABLED=true
# AI Provider: openai, gemini, groq, or together
AI_PROVIDER=openai

# OpenAI - Get API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google AI (Gemini) - Get API key from https://aistudio.google.com/app/apikey
GOOGLE_AI_API_KEY=

# Groq - Get API key from https://console.groq.com/
GROQ_API_KEY=

# Together AI - Get API key from https://api.together.xyz/
TOGETHER_API_KEY=

# =========================
# REDIS (Optional - for rate limiting and real-time features)
# =========================
# Option 1: Full connection string
REDIS_URL=redis://localhost:6379

# Option 2: Split configuration (if not using REDIS_URL)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# =========================
# TELEGRAM (Optional - for bot notifications)
# =========================
# Get bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
# Webhook secret for secure webhook validation
TELEGRAM_WEBHOOK_SECRET=

# =========================
# CRON (Required for production - Vercel Cron jobs)
# =========================
# Set a secret; Vercel will send it as Authorization: Bearer
CRON_SECRET=

# =========================
# DEV (Optional - for super-admin email verification bypass)
# =========================
# SUPER_ADMIN_DEV_EMAIL=your@email.com

# =========================
# NOTES
# =========================
# 1. Generate NEXTAUTH_SECRET: openssl rand -base64 32
# 2. Database will be created automatically on first migration
# 3. Run `npm run db:seed` after setup to create admin account
# 4. Optional services can be left empty if not needed
